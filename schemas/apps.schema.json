{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/jiye-kim-dev/logstitch/main/schemas/apps.schema.json",
  "title": "logstitch apps.json",
  "description": "애플리케이션별 검색 규칙. 필수 필드는 앱의 로그 스키마 속성이므로 환경과 무관하다 — 인벤토리(환경별 파일)가 아니라 이 파일 하나에 모아둔다. 근거: collector/apps/apps.go",
  "type": "object",
  "required": ["apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "$ref": "#/definitions/comment" },
    "apps": {
      "type": "object",
      "description": "앱 이름 → 검색 규칙. 최소 1개.",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/app" }
    }
  },
  "definitions": {
    "comment": {
      "description": "사람용 주석. 코드는 읽지 않는다.",
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "app": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "_comment": { "$ref": "#/definitions/comment" },
        "required": {
          "type": "array",
          "description": "이 앱을 조회할 때 반드시 넘겨야 하는 필드. 순서가 의미를 가진다 — 원격에서 grep 을 이 순서로 이어붙이므로 가장 선택적인(결과가 적게 나오는) 필드를 앞에 두면 전송량이 줄어든다.",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "view": { "$ref": "#/definitions/viewHint" },
        "parser": { "$ref": "#/definitions/parserHint" },
        "note": {
          "type": "string",
          "description": "사람용 메모. 코드는 쓰지 않는다."
        }
      }
    },
    "viewHint": {
      "type": "object",
      "description": "파서를 위한 표현 힌트. 수집기는 해석하지 않고 meta 이벤트에 그대로 실어 보낸다. 근거: parser/src/types.ts ViewHint",
      "additionalProperties": false,
      "properties": {
        "default": {
          "description": "기본 뷰 이름. --view 플래그 > 이 힌트 > 프로필 기본값 순으로 적용된다.",
          "enum": ["timeline", "flow", "contention"]
        },
        "lane": {
          "type": "string",
          "description": "contention 뷰에서 레인을 나눌 필드 (예: server_id). 없으면 host 로 나눈다."
        },
        "session": {
          "type": "string",
          "description": "세션 구분 필드 (예: trace_id). 레인 안에서 세션이 바뀌는 지점을 표시한다."
        },
        "laneFallback": {
          "description": "lane 필드가 없거나 빈 줄의 레인 폴백. 한 호스트가 인스턴스 여러 개를 돌리고 인벤토리 소스명이 인스턴스를 식별하면 'source', 호스트마다 같은 소스명을 쓰는 배치면 'host'(기본).",
          "enum": ["host", "source"]
        }
      }
    },
    "parserHint": {
      "type": "object",
      "description": "파서를 위한 필드 별칭 힌트 — 표준 키를 안 쓰는 앱을 코드 수정 없이 흡수한다. 앱이 지정한 키가 전역 별칭보다 먼저 잡힌다. 근거: parser/src/types.ts ParserHint",
      "additionalProperties": false,
      "properties": {
        "tsKeys": {
          "type": "array",
          "description": "타임스탬프 키 별칭 (예: [\"event_time\"])",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "levelKeys": {
          "type": "array",
          "description": "레벨 키 별칭 (예: [\"sev\"])",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "msgKeys": {
          "type": "array",
          "description": "메시지 키 별칭 (예: [\"description\"])",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "callerKeys": {
          "type": "array",
          "description": "호출 위치 키 별칭 (예: [\"origin\"])",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  }
}
